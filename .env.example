# Copy to .env for LOCAL testing only. On Vercel, add these in Project Settings -> Environment Variables.
# NEVER commit the real .env or serviceAccountKey.json to GitHub.

# Whole content of your Firebase serviceAccountKey.json (paste it as one line), or its base64.
FIREBASE_SERVICE_ACCOUNT=

# Gmail OTP sender (Brevo API) - same values as your old backend-sync/.env
BREVO_API_KEY=
BREVO_SENDER=

# ...or Gmail SMTP instead of Brevo:
# GMAIL_USER=yourshop@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: any long random text. Used to sign login sessions. (If empty, it is derived from the Firebase key.)
SESSION_SECRET=
